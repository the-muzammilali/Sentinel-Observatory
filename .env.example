# Google Gemini API Configuration
GOOGLE_API_KEY=your_api_key_here

# Simulation Configuration
USE_SCOPESIM=true  # Set to false to use synthetic fallback
SIMULATION_SPEED=2  # Real seconds per simulated 30 minutes

# Telescope Configuration
IMAGE_SIZE=1024
FIELD_OF_VIEW=60  # arcseconds
NUM_STATIC_STARS=500

# Agent Configuration
GEMINI_MODEL=gemini-3-flash
MAX_RETRIES=3
RETRY_DELAY=2.0

# Dashboard Configuration
DASHBOARD_PORT=8501
REFRESH_RATE=1.0  # seconds