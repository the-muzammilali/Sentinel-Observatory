# Sentinel Observatory - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Hardcoded credentials for hackathon deployment
# Change these for production!
AUTH_USERNAME=sentinel
AUTH_PASSWORD=observatory2024

# ============================================================================
# GOOGLE GEMINI API
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
# You can provide multiple keys separated by commas for rotation
GOOGLE_API_KEY=your_api_key_here
GOOGLE_API_KEYS=key1,key2,key3

# Model to use (default: gemini-3.0-flash)
GEMINI_MODEL=gemini-3.0-flash

# Agent Configuration
MAX_RETRIES=3
RETRY_DELAY=2.0

# ============================================================================
# SIMULATION CONFIGURATION
# ============================================================================
# Use ScopeSim for realistic telescope simulation (true) or synthetic fallback (false)
USE_SCOPESIM=true

# Simulation speed (real seconds per simulated 30 minutes)
SIMULATION_SPEED=2

# ============================================================================
# TELESCOPE CONFIGURATION
# ============================================================================
# Image dimensions (pixels)
IMAGE_SIZE=1024

# Field of view (arcseconds)
FIELD_OF_VIEW=60

# Number of static stars in field
NUM_STATIC_STARS=500

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Allowed origins for CORS (comma-separated)
# For local development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# For production (replace with your domain):
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# DASHBOARD CONFIGURATION
# ============================================================================
# Dashboard port (if using Streamlit - optional)
DASHBOARD_PORT=8501

# Refresh rate for dashboard updates (seconds)
REFRESH_RATE=1.0

# ============================================================================
# DEPLOYMENT
# ============================================================================
# Set to 'production' in production environment
ENVIRONMENT=development

# Backend port (default: 8000)
BACKEND_PORT=8000

# Frontend port (default: 3000)
FRONTEND_PORT=3000
